{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.snurre66.network-presence",
  "version": "1.0.1",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "brandColor": "#1E88E5",
  "name": {
    "en": "Network Presence",
    "no": "Nettverk Tilstedeværelse"
  },
  "description": {
    "en": "Robust network presence detection for Homey Pro without requiring any app on your phone.",
    "no": "Robust tilstedeværelsesdeteksjon for Homey Pro basert på lokalnettverk uten behov for app på telefonen."
  },
  "category": [
    "tools"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "snurre66",
    "email": "48808867+snurre66@users.noreply.github.com"
  },
  "flow": {
    "triggers": [
      {
        "id": "turned_home",
        "title": {
          "en": "Came home",
          "no": "Kom hjem"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=phone"
          }
        ]
      },
      {
        "id": "turned_away",
        "title": {
          "en": "Left home",
          "no": "Forlot hjemmet"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=phone"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_home",
        "title": {
          "en": "Is !{{at home|away}}",
          "no": "Er !{{hjemme|borte}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=phone"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "force_probe",
        "title": {
          "en": "Force presence check",
          "no": "Tving tilstedeværelsessjekk"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=phone"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Phone / Person",
        "no": "Telefon / Person"
      },
      "class": "sensor",
      "capabilities": [
        "alarm_presence"
      ],
      "capabilitiesOptions": {
        "alarm_presence": {
          "title": {
            "en": "Presence",
            "no": "Tilstedeværelse"
          }
        }
      },
      "images": {
        "small": "/drivers/phone/assets/images/small.png",
        "large": "/drivers/phone/assets/images/large.png",
        "xlarge": "/drivers/phone/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "select_user"
          }
        },
        {
          "id": "select_user",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "label": {
            "en": "IP Address",
            "no": "IP-adresse"
          },
          "value": "",
          "hint": {
            "en": "Current IP address of the device (e.g. 192.168.68.75)",
            "no": "Nåværende IP-adresse til telefonen (f.eks. 192.168.68.75)"
          }
        },
        {
          "id": "hostname",
          "type": "text",
          "label": {
            "en": "mDNS / Bonjour Hostname",
            "no": "mDNS / Bonjour Vertsnavn"
          },
          "value": "",
          "hint": {
            "en": "Local hostname ending in .local (e.g. Thomas-iPhone.local). Allows automatic tracking if IP changes.",
            "no": "Lokalt vertsnavn som slutter på .local (f.eks. Thomas-iPhone.local). Tillater automatisk gjenkjenning dersom IP endres."
          }
        },
        {
          "id": "auto_rediscover",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Auto-Discover New IP on Reconnect",
            "no": "Automatisk søk ved endret IP"
          },
          "hint": {
            "en": "Automatically scans local network and migrates to new IP if phone receives a new DHCP address",
            "no": "Søker automatisk i lokalnettverket og migrerer til ny IP dersom telefonen tildeles ny adresse"
          }
        },
        {
          "id": "away_delay",
          "type": "number",
          "min": 1,
          "max": 60,
          "step": 1,
          "value": 10,
          "label": {
            "en": "Away Grace Period (minutes)",
            "no": "Forsinkelse før borte (minutter)"
          },
          "hint": {
            "en": "Minutes of silence before marking as away (standard 10 min avoids false triggers while the phone sleeps)",
            "no": "Minutter uten kontakt før status settes til borte (standard 10 min unngår falske alarmer når telefonen sover i lommen)"
          }
        },
        {
          "id": "probe_interval",
          "type": "number",
          "min": 5,
          "max": 120,
          "step": 5,
          "value": 15,
          "label": {
            "en": "Probe Interval (seconds)",
            "no": "Sonderingsintervall (sekunder)"
          },
          "hint": {
            "en": "Interval between network probes when at home (default: 15s)",
            "no": "Tidsintervall mellom hver nettverkssjekk når personen er hjemme (standard: 15 sek)"
          }
        },
        {
          "id": "tcp_ports",
          "type": "text",
          "value": "62078,5353,80,443",
          "label": {
            "en": "Probe Ports (TCP)",
            "no": "Sonderingsporter (TCP)"
          },
          "hint": {
            "en": "Comma-separated TCP ports to probe (62078 for iOS, 5353 mDNS, 80 HTTP, 443 HTTPS)",
            "no": "Kommaseparerte TCP-porter (62078 for iOS, 5353 mDNS, 80 HTTP, 443 HTTPS)"
          }
        },
        {
          "id": "homey_user",
          "type": "dropdown",
          "value": "none",
          "label": {
            "en": "Homey Person",
            "no": "Homey-person"
          },
          "hint": {
            "en": "Select which registered Homey person this phone belongs to",
            "no": "Velg hvilken registrert person i Homey denne telefonen tilhører"
          },
          "values": [
            {
              "id": "none",
              "label": {
                "en": "-- Do not sync --",
                "no": "-- Ikke synkroniser --"
              }
            },
            {
              "id": "aed2c21c-c3a8-43f0-b446-d4d2d558ad07",
              "label": {
                "en": "Thomas Veivåg",
                "no": "Thomas Veivåg"
              }
            },
            {
              "id": "95dcd577-8e6d-4a55-9898-b2b7d5351ccb",
              "label": {
                "en": "Marta-Kristine Ognøy",
                "no": "Marta-Kristine Ognøy"
              }
            },
            {
              "id": "17081d71-f69d-4205-91b0-b123a01dd41a",
              "label": {
                "en": "Emilie Veivåg",
                "no": "Emilie Veivåg"
              }
            },
            {
              "id": "e46751f2-20c2-45a4-90f1-43cee4808a2b",
              "label": {
                "en": "Mariell Veivåg",
                "no": "Mariell Veivåg"
              }
            }
          ]
        }
      ],
      "id": "phone"
    }
  ]
}